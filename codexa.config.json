{
  "version": 2,
  "blameMode": "strict",
  "languages": [
    "auto"
  ],
  "severity": {
    "block": [
      "CRITICAL"
    ],
    "warn": [
      "MODERATE"
    ],
    "log": [
      "MINOR"
    ],
    "overrides": {}
  },
  "ignore": [
    "node_modules",
    ".git",
    "dist",
    "build",
    "__pycache__",
    "*.min.js",
    "migrations/"
  ],
  "team": {
    "name": "Solo Developer",
    "enforceOnCI": false,
    "blockThreshold": 1,
    "requireModel": null,
    "allowForceCommit": true,
    "forceCommitRequiresReason": false
  },
  "ci": {
    "outputFormat": "json",
    "postPRComment": false,
    "failOn": "CRITICAL",
    "badge": false
  },
  "adapterFailurePolicy": "fail",
  "adapterTimeoutMs": 30000,
  "_codexaSchema": 2
}